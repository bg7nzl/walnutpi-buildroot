// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * WalnutPi 1B / ZeroW 共用 SoC 外设（同一份 DTB）。
 *
 * 板级走核桃派原理图，不是 OrangePi，也不是官方 DTB / 未测完的魔改：
 *   核桃派1B_2G_4G版本_sch.pdf Device2 POWER
 *   核桃派ZeroW_sch.pdf Device2 POWER
 *   axp313a_datasheet_v0.1.pdf
 * 芯片怎么出现在 DT 里走主线绑定：sun50i-h616.dtsi、
 * sun50i-h616-cpu-opp.dtsi、x-powers,axp313a。
 *
 * AXP313A 手册表 7-1「应用建议」DCDC1=CPU、DCDC2=GPU 只是通用示例。
 * 核桃派电路相反：DCDC1→VDD-SYS+VDD-GPU（1.5 A），DCDC2→VDD-CPU（3 A）。
 */

#include "sun50i-h616.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	aliases {
		serial0 = &uart0;
		serial2 = &uart2;
		serial4 = &uart4;
		mmc0 = &mmc0;
		mmc1 = &mmc1;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		spi1 = &spi1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	connector {
		compatible = "hdmi-connector";
		type = "d";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};

	leds {
		compatible = "gpio-leds";

		led-status {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&pio 2 13 GPIO_ACTIVE_HIGH>; /* PC13 */
			default-state = "on";
		};
	};

	gpio_keys: gpio-keys {
		compatible = "gpio-keys";

		key-user {
			label = "user";
			linux,code = <KEY_POWER>;
			gpios = <&pio 2 12 GPIO_ACTIVE_LOW>; /* PC12 */
			wakeup-source;
		};
	};

	/* Type-C VBUS，板级 5 V 输入，同时给 USB-A 口供电 */
	reg_vcc5v: vcc5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	/*
	 * U5 XC6220-3.3V1A：3V3-WIFI。WiFi 模组 VIN 走这一路，不是 AXP DLDO1。
	 * EN 在原理图上常开，无 GPIO。
	 */
	reg_vcc33_wifi: vcc33-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vcc33-wifi";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		vin-supply = <&reg_vcc5v>;
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		/* M1 WL_REG_ON ← PG18，高电平使能；pwrseq reset 低有效 */
		reset-gpios = <&pio 6 18 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <200>;
	};
};

/*
 * 主线 sun50i-h616.dtsi 给 CPU 写了 #cooling-cells 和 60/70°C trip，
 * 但没有 cooling-maps（同世代的 sun50i-h6.dtsi 有）。按 H6 的写法补上。
 */
&{/thermal-zones/cpu-thermal} {
	polling-delay-passive = <250>;
	polling-delay = <1000>;

	trips {
		cpu-trip-0 {
			hysteresis = <2000>;
		};

		cpu-trip-1 {
			hysteresis = <2000>;
		};
	};

	cooling-maps {
		map0 {
			trip = <&cpu_target>;
			cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
		};
	};
};

&cpu0 {
	cpu-supply = <&reg_dcdc2>;
};

&de {
	status = "okay";
};

&ehci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&ehci2 {
	status = "okay";
};

&ehci3 {
	status = "okay";
};

&ohci0 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&ohci2 {
	status = "okay";
};

&ohci3 {
	status = "okay";
};

&gpu {
	mali-supply = <&reg_dcdc1>;
	status = "okay";
};

&hdmi {
	hvcc-supply = <&reg_aldo1>;
	status = "okay";
};

&hdmi_out {
	hdmi_out_con: endpoint {
		remote-endpoint = <&hdmi_con_in>;
	};
};

&mmc0 {
	vmmc-supply = <&reg_dldo1>;
	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>; /* PF6 / SDC0-DET */
	bus-width = <4>;
	status = "okay";
};

&mmc1 {
	vmmc-supply = <&reg_vcc33_wifi>;
	vqmmc-supply = <&reg_aldo1>;
	mmc-pwrseq = <&wifi_pwrseq>;
	bus-width = <4>;
	non-removable;
	mmc-ddr-1_8v;
	status = "okay";

	sdio_wifi: wifi@1 {
		reg = <1>;
		compatible = "unisoc,uwe5622", "sprd,unisoc-wifi";
	};
};

/* 40Pin 复用默认关闭，留给 GPIO；用 overlay 打开。 */
&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pi_pins>;
	status = "disabled";
};

&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pi_pins>;
	status = "disabled";
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2_pi_pins>;
	status = "disabled";
};

&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart4_pi_pins>;
	status = "disabled";
};

&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pins>, <&spi1_cs0_pin>, <&spi1_cs1_pin>;
	status = "disabled";
};

&pio {
	vcc-pc-supply = <&reg_dldo1>;
	vcc-pf-supply = <&reg_dldo1>;
	vcc-pg-supply = <&reg_aldo1>;
	vcc-ph-supply = <&reg_dldo1>;
	vcc-pi-supply = <&reg_dldo1>;

	i2c1_pi_pins: i2c1-pi-pins {
		pins = "PI7", "PI8";
		function = "i2c1";
	};

	i2c2_pi_pins: i2c2-pi-pins {
		pins = "PI9", "PI10";
		function = "i2c2";
	};

	uart2_pi_pins: uart2-pi-pins {
		pins = "PI5", "PI6";
		function = "uart2";
	};

	uart4_pi_pins: uart4-pi-pins {
		pins = "PI13", "PI14";
		function = "uart4";
	};

	pwm1_pi_pin: pwm1-pi-pin {
		pins = "PI11";
		function = "pwm1";
	};

	pwm2_pi_pin: pwm2-pi-pin {
		pins = "PI12";
		function = "pwm2";
	};

	pwm3_pi_pin: pwm3-pi-pin {
		pins = "PI13";
		function = "pwm3";
	};

	pwm4_pi_pin: pwm4-pi-pin {
		pins = "PI14";
		function = "pwm4";
	};

	spi1_cs1_pin: spi1-cs1-pin {
		pins = "PH9";
		function = "spi1";
	};
};

/* 基线只给 AC200 留 pwm5；PI11–PI14 的 PWM 走 overlay。 */
&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm5_pin>;
	status = "okay";
};

&r_i2c {
	status = "okay";

	/*
	 * U4/U3 AXP313A：SDA/SCL = PMU-SDA/PMU-SCK = S_TWI0 = PL1/PL0 = r_i2c。
	 * TWSI 地址手册可配 0x36/0x37，原理图无改址，用 0x36。
	 * 脚 11 IRQ 原理图打 X，未接到 SoC，不写 interrupts。
	 * 绑定里 axp313a 不强制 IRQ。无 MODESET 自工作脚，不加 self-working-mode。
	 */
	axp313: pmic@36 {
		compatible = "x-powers,axp313a";
		reg = <0x36>;

		vin1-supply = <&reg_vcc5v>;
		vin2-supply = <&reg_vcc5v>;
		vin3-supply = <&reg_vcc5v>;

		regulators {
			/* ALDO1 → 1V8（VCC-PLL、VCC_PG、WiFi VDDIO） */
			reg_aldo1: aldo1 {
				regulator-always-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc1v8";
			};

			/* DLDO1 → 3V3（VCC-IO、TF、USB PHY IO 等） */
			reg_dldo1: dldo1 {
				regulator-always-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc3v3";
			};

			/*
			 * DCDC1 → VDD-SYS + VDD-GPU。原理图反馈点标 0.9 V。
			 * 手册：0.5–3.4 V，IMAX 1.5 A。无 GPU OPP 表，锁在原理图电压。
			 */
			reg_dcdc1: dcdc1 {
				regulator-always-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-name = "vdd-gpu-sys";
			};

			/*
			 * DCDC2 → VDD-CPU。原理图反馈点标 0.9 V（OTP 默认）。
			 * 手册：0.5–1.54 V，IMAX 3 A@5 V。
			 * 主线 sun50i-h616-cpu-opp.dtsi：900–1160 mV（含 speed5 1.512 GHz）。
			 */
			reg_dcdc2: dcdc2 {
				regulator-always-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <1160000>;
				regulator-name = "vdd-cpu";
			};

			/*
			 * DCDC3 → VCC-DRAM。手册默认电压可 OTP 定制，IMAX 2 A。
			 * 1B（含停产 1G 与现量产 2G/4G）原理图标 1.3 V；
			 * ZeroW 原理图标 1.1 V。共用 DTB 不改写此路，交给出厂 OTP。
			 */
			reg_dcdc3: dcdc3 {
				regulator-always-on;
				regulator-name = "vcc-dram";
			};
		};
	};
};

&sid {
	ephy_calibration: ephy-calibration@2c {
		reg = <0x2c 0x2>;
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_ph_pins>;
	status = "okay";
};

&usbotg {
	dr_mode = "otg";
	status = "okay";
};

&usbphy {
	/* USB-A VBUS 直接接板级 5 V，无 PC16 之类使能脚 */
	usb1_vbus-supply = <&reg_vcc5v>;
	status = "okay";
};
