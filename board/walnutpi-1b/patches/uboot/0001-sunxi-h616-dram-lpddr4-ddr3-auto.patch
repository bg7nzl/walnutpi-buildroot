+static const u8 *mctl_phy_init_seq(enum sunxi_dram_type type, unsigned int *count)
+{
+	switch (type) {
+	case SUNXI_DRAM_TYPE_LPDDR4:
+		*count = ARRAY_SIZE(phy_init_lpddr4);
+		return phy_init_lpddr4;
+	case SUNXI_DRAM_TYPE_LPDDR3:
+		*count = ARRAY_SIZE(phy_init_lpddr3);
+		return phy_init_lpddr3;
+	default:
+		*count = ARRAY_SIZE(phy_init_ddr3);
+		return phy_init_ddr3;
+	}
