+static void walnutpi_dram_apply_type(struct dram_para *para,
+				     enum sunxi_dram_type type)
+{
+	para->type = type;
+	/*
+	 * DDR3 bit-delay bytes from walnutpi/uboot dram_sun50i_h616.c
+	 * (board PHY calibration). LPDDR4 TPR11/TPR12 come from Kconfig.
+	 */
+	if (type == SUNXI_DRAM_TYPE_DDR3) {
+		para->tpr11 = 0x1a1a1a16;
+		para->tpr12 = 0x14121210;
+	}
+}
 
 unsigned long sunxi_dram_init(void)
 {
 	struct sunxi_prcm_reg *const prcm =
 		(struct sunxi_prcm_reg *)SUNXI_PRCM_BASE;
