+static void walnutpi_load_ddr3(struct dram_para *para, unsigned int clk)
+{
+	para->type = SUNXI_DRAM_TYPE_DDR3;
+	para->clk = clk;
+	para->dx_odt = 0x08080808;
+	para->tpr6 = 0x3300c080;
+	para->tpr10 = 0x00f83438;
+	para->tpr11 = 0;
