+
+static void walnutpi_load_lpddr4(struct dram_para *para, u32 tpr6, u32 tpr10,
+				 u32 tpr11, u32 tpr12)
+{
+	para->type = SUNXI_DRAM_TYPE_LPDDR4;
+	para->clk = 792;
+	para->dx_odt = 0x07070707;
+	para->tpr6 = tpr6;
+	para->tpr10 = tpr10;
+	para->tpr11 = tpr11;
+	para->tpr12 = tpr12;
+}
+
+static bool walnutpi_try(const char *tag, struct dram_para *para,
+			 struct dram_config *config)
+{
+	if (mctl_auto_detect_rank_width(para, config)) {
+		printf(" %s+", tag);
+		return true;
 	}
+	printf(" %s-", tag);
+	return false;
 }
 
