#!/bin/sh
# Print how to SSH on the serial/HDMI console.

announce() {
	{
		echo
		echo "==== WalnutPi 1B/Zero ===="
		echo "SSH: ssh root@walnutpi.local   密码 walnutpi"
		echo "网卡:"
		ip -4 -o addr show 2>/dev/null | awk '{print "  "$2, $4}' || true
		echo "WiFi: wifi-setup <SSID> <密码>"
		echo "GPIO: overlay pins   /   overlay enable i2c1|spi1|uart2|..."
		echo "=========================="
		echo
	} | tee /run/walnutpi-net.txt >/dev/console 2>/dev/null || true
	[ -c /dev/ttyS0 ] && cat /run/walnutpi-net.txt > /dev/ttyS0 2>/dev/null || true
}

case "$1" in
	start)
		announce
		# DHCP 在后台，稍后再打一次地址
		( sleep 12; announce ) &
		;;
	stop)
		;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac
