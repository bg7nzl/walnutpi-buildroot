#!/bin/sh
# 串口 / HDMI 打印 SSH 与 /data 状态。

announce() {
	st=unknown
	[ -f /run/walnutpi-data.state ] && st=$(cat /run/walnutpi-data.state)
	hn=walnutpi
	if [ -f /run/walnutpi.env ]; then
		# shellcheck disable=SC1091
		. /run/walnutpi.env
		hn=${hostname:-walnutpi}
	fi
	{
		echo
		echo "==== WalnutPi 1B/Zero hardened ===="
		echo "SSH: ssh root@${hn}.local   默认密码 walnutpi"
		echo "data: $st   配置: /data/walnutpi.conf"
		echo "网卡:"
		ip -4 -o addr show 2>/dev/null | awk '{print "  "$2, $4}' || true
		echo "WiFi: wifi-setup <SSID> <密码>"
		echo "GPIO: overlay pins / overlay enable i2c1|spi1|uart2|..."
		echo "      改 overlay 后 reboot（U-Boot 叠 dtbo）"
		echo "=========================="
		echo
	} | tee /run/walnutpi-net.txt >/dev/console 2>/dev/null || true
	[ -c /dev/ttyS0 ] && cat /run/walnutpi-net.txt > /dev/ttyS0 2>/dev/null || true
}

case "$1" in
	start)
		announce
		( sleep 12; announce ) &
		;;
	stop)
		;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac
