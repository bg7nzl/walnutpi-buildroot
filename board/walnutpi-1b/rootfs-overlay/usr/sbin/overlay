#!/bin/sh
# 40Pin overlay 只写 /data/walnutpi.conf，由 U-Boot 下一次启动叠加。
set -eu

usage() {
	cat <<'EOF'
用法:
  overlay pins
  overlay enable NAME
  overlay disable NAME
  overlay status
NAME: i2c1 i2c2 uart2 uart4 spi1 pwm1 pwm2 pwm12 pwm3 pwm4 pwm34
uart4 与 pwm3/pwm4/pwm34 互斥。改完需要 reboot。
EOF
	exit 1
}

cmd=${1:-}
case "$cmd" in
pins)
	cat <<'EOF'
 1  3.3V           2  5V
 3  PI8  I2C1 SDA  4  5V
 5  PI7  I2C1 SCL  6  GND
 7  PC8            8  PI5  UART2 TX
 9  GND           10  PI6  UART2 RX
11  PC9           12  PC10
13  PC11          14  GND
15  PI11 PWM1     16  PI12 PWM2
17  3.3V          18  PC14
19  PH7  SPI MOSI 20  GND
21  PH8  SPI MISO 22  PC15
23  PH6  SPI SCLK 24  PH5  SPI CS0
25  GND           26  PH9  SPI CS1
27  PI10 I2C2 SDA 28  PI9  I2C2 SCL
29  PI0           30  GND
31  PI1           32  PI16
33  PI2           34  GND
35  PI3           36  PI15
37  PI4           38  PI13 PWM3 / UART4 TX
39  GND           40  PI14 PWM4 / UART4 RX
gpiochip1 行号 = bank×32+n（PA=0…PI=8）。PC8=72，PI8=264，PH7=231。
EOF
	;;
enable)
	[ $# -eq 2 ] || usage
	walnutpi-config overlay-enable "$2"
	;;
disable)
	[ $# -eq 2 ] || usage
	walnutpi-config overlay-disable "$2"
	;;
status)
	walnutpi-config overlay-status
	;;
*)
	usage
	;;
esac
