#!/bin/sh
# 把 WiFi 写进 /data/walnutpi.conf（PSK 存 64 位十六进制，不存明文）。
set -eu

usage() {
	echo "用法: wifi-setup scan | wifi-setup SSID [密码]" >&2
	exit 1
}

bring_wlan() {
	ip link set wlan0 up 2>/dev/null || true
	sleep 1
}

case "${1:-}" in
scan)
	bring_wlan
	iw dev wlan0 scan | awk '
		/^BSS / { b=$2 }
		/SSID:/ { $1=""; sub(/^ /,""); print }
	'
	;;
"")
	usage
	;;
*)
	ssid=$1
	psk=${2:-}
	hex=
	if [ -n "$psk" ]; then
		if ! command -v wpa_passphrase >/dev/null; then
			echo "wifi-setup: 没有 wpa_passphrase" >&2
			exit 1
		fi
		hex=$(wpa_passphrase "$ssid" "$psk" | awk '/^[[:space:]]*psk=/ { sub(/^[^=]*=/, ""); print; exit }')
		[ -n "$hex" ] || { echo "wifi-setup: 无法从密码算出 PSK" >&2; exit 1; }
	fi
	walnutpi-config set wifi_ssid "$ssid"
	walnutpi-config set wifi_psk "$hex"
	echo "已写入 /data/walnutpi.conf。立刻关联："
	/etc/init.d/S60wifi start || true
	;;
esac
