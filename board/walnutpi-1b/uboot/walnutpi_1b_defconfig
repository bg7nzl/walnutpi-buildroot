CONFIG_ARM=y
CONFIG_ARCH_SUNXI=y
CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-h616-walnutpi-1b"
CONFIG_SPL=y
CONFIG_MACH_SUN50I_H616=y
CONFIG_SUNXI_DRAM_H616_LPDDR4=y
CONFIG_DRAM_CLK=792
# H616 DRAM PHY：DX/ODT 与 LPDDR4 TPR 来自核桃派 vendor U-Boot。
# SPL 按官方 AUTO：先 DDR3 再 LPDDR4；DDR3 不开 write leveling / bit-delay。
# TPR6 高字节 0x44 = LPDDR4 PHY 0x3dc/0x45c；低字节 0x80 给停产 DDR3。
CONFIG_DRAM_SUN50I_H616_DX_ODT=0x07070707
CONFIG_DRAM_SUN50I_H616_DX_DRI=0x0e0e0e0e
CONFIG_DRAM_SUN50I_H616_CA_DRI=0x0e0e
CONFIG_DRAM_SUN50I_H616_ODT_EN=0xaaaaeeee
CONFIG_DRAM_SUN50I_H616_TPR6=0x4400c080
# 官方 vendor 打开 read/write training（TPR10 bit22/23），否则校准过了数据仍是垃圾。
CONFIG_DRAM_SUN50I_H616_TPR10=0x40ef6663
CONFIG_DRAM_SUN50I_H616_TPR11=0x24242323
CONFIG_DRAM_SUN50I_H616_TPR12=0x0e0e0e0e
# USB-A VBUS 原理图直接接 5 V，无使能 GPIO。
CONFIG_USB1_VBUS_PIN=""
# CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
# SPL 只写 DCDC3=1.1 V（官方 AUTO）。主线会顺带写 DCDC2，工厂补丁跳过。
CONFIG_R_I2C_ENABLE=y
CONFIG_SPL_I2C=y
CONFIG_SPL_SYS_I2C_LEGACY=y
CONFIG_SYS_I2C_MVTWSI=y
CONFIG_SYS_I2C_SLAVE=0x7f
CONFIG_SYS_I2C_SPEED=400000
CONFIG_AXP313_POWER=y
CONFIG_AXP_DCDC3_VOLT=1100
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_MUSB_GADGET=y
# 禁止把环境写进 FAT。引导脚本只读 SD。
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_CMD_SAVEENV is not set
# CONFIG_FAT_WRITE is not set
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="load mmc 0:1 ${scriptaddr} boot.scr && source ${scriptaddr}"
CONFIG_BOOTMETH_SCRIPT=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_IMPORTENV=y
CONFIG_OF_LIBFDT_OVERLAY=y
